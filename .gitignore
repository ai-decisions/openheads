__pycache__/
*.pyc
*.egg-info/
build/
dist/
.venv/
.env
# Model weights and run artefacts never belong in this repo.
*.pt
*.pth
*.npz
*.npy
*.parquet
out/
runs/
models/
# The shipped registry lives inside the package (src/openabm/data/), which the
# rule below does not touch: a pattern containing a slash is anchored to this
# file's directory. A repo-root data/ only ever holds local scraper artefacts,
# so everything in it is ignored — including a stray regenerated registry.
data/*
.claude/
.ruff_cache/
*.ckpt
checkpoints/
lightning_logs/
.pytest_cache/
runs/
